{
  "name": "nopeek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3033",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3033",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "chain:init": "tsx scripts/init-chain.ts",
    "format": "prettier --write src tests scripts *.ts *.json *.mjs",
    "format:check": "prettier --check src tests scripts *.ts *.json *.mjs"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.2",
    "@arcium-hq/client": "0.13.2",
    "@phosphor-icons/react": "^2.1.10",
    "@solana/web3.js": "1.98.4",
    "buffer": "^6.0.3",
    "next": "16.3.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "tweetnacl": "^1.0.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "toml": "^5.0.0",
    "uuid": "^11.1.1",
    "jayson": "4.1.3",
    "rpc-websockets": "9.3.8"
  },
  "engines": {
    "node": "22.x"
  }
}
